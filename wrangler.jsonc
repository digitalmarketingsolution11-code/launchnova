{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "launchnova",
  "main": "dist/boot.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
