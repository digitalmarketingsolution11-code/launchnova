{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "launchnova",
  "main": "api/boot.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS"
  },
  "vars": {
    "APP_ID": "your-app-id-here",
    "DATABASE_URL": "your-database-url-here"
  },
  "observability": {
    "enabled": true
  }
}
